{
  "name": "instabizweb-backend",
  "version": "1.0.0",
  "description": "InstaBizWeb - REST API backend (Express + TypeScript + PostgreSQL)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "format": "prettier --write .",
    "migrate": "ts-node src/db/migrate.ts",
    "seed:admin": "ts-node src/db/seedAdmin.ts"
  },
  "keywords": [
    "instabizweb",
    "express",
    "postgresql",
    "typescript"
  ],
  "author": "InstaBizWeb Intern",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.23.0",
    "serverless-http": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "husky": "^9.1.7",
    "nodemon": "^3.1.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
