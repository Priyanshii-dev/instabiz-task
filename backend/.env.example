# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/instabizweb
PGSSL=false

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Seed admin (used only by npm run seed:admin)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@instabizweb.com
SEED_ADMIN_PASSWORD=ChangeMe123!
